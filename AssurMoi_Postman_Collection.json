        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/user/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "1"
              ]
            }
          }
        },
        {
          "name": "Update User (Advance Step)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"updated_employee@assurmoi.fr\",\n  \"role\": \"Administrateur\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/user/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "1"
              ]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/user/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "1"
              ]
            }
          }
        }
      ]
    },
